# Copy to .env (same folder) and fill in. .env is git-ignored: never commit real values.
#   Windows:  copy .env.example .env      macOS/Linux:  cp .env.example .env
# Format: KEY=value, no quotes. Spring reads it as a .properties file, so a "\" in a value must be "\\".

# --- Database (MySQL) -------------------------------------------------------
# sslMode=REQUIRED forces TLS. In production use VERIFY_IDENTITY plus the server's CA.
DB_URL=jdbc:mysql://localhost:3306/jamix_fashion?sslMode=REQUIRED&connectionTimeZone=UTC&characterEncoding=UTF-8
# Application account: data access only (SELECT/INSERT/UPDATE/DELETE).
DB_USERNAME=jamix_app
DB_PASSWORD=

# Migration account used by Flyway at startup (CREATE/ALTER/INDEX...).
# To run migrations with the application account instead, leave both empty (or remove them).
DB_MIGRATION_USERNAME=jamix_migrator
DB_MIGRATION_PASSWORD=

# --- Security ------------------------------------------------------------------
# JWT signing key, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JAMIX_JWT_SECRET=
JAMIX_ADMIN_PASSWORD=
JAMIX_CUSTOMER_PASSWORD=
