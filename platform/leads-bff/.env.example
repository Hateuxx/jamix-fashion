PORT=4000
# Public URL of the SSR storefront; invalid no-JS form posts are sent back here.
SITE_URL=http://localhost:8080
# Origins allowed to call the API with fetch (comma-separated).
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
WHATSAPP_NUMBER=51912452389
# Optional: where to POST each lead (n8n, Zapier, Slack, a WhatsApp Cloud API adapter...).
LEADS_WEBHOOK_URL=
# Set to 1 when running behind the gateway/reverse proxy so rate limiting sees the real client IP.
TRUST_PROXY=0
